+  zenAddToBoard(event) {
+    const win = this.window;
+    const doc = this.document;
+    const marquee = this.highlightEl;
+    
+    // Get viewport coordinates of the selection marquee
+    const rect = marquee.getBoundingClientRect();
+    
+    // FOOLPROOF SCROLL DETECTION: 
+    // We find where the absolute (0,0) of the document is relative to the viewport.
+    let scrollX = 0;
+    let scrollY = 0;
+    const anchor = doc.createElement("div");
+    anchor.style.cssText = "position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none;visibility:hidden;";
+    doc.documentElement.appendChild(anchor);
+    const anchorRect = anchor.getBoundingClientRect();
+    scrollX = -anchorRect.left;
+    scrollY = -anchorRect.top;
+    anchor.remove();
+
+    // Document-absolute coordinates: viewport position + anchor-derived scroll
+    const absoluteLeft = rect.left + scrollX;
+    const absoluteTop = rect.top + scrollY;
+
+    Services.console.logStringMessage(`ZenBoard Anchor Debug: rect=${rect.left},${rect.top} anchor=${anchorRect.left},${anchorRect.top} -> final=${absoluteLeft},${absoluteTop}`);
+
+    this.#dispatchEvent("Screenshots:ZenAddToBoard", {
+      anchor: { x: event.screenX, y: event.screenY },
+      region: {
+        left: absoluteLeft,
+        top: absoluteTop,
+        right: absoluteLeft + rect.width,
+        bottom: absoluteTop + rect.height,
+        width: rect.width,
+        height: rect.height,
+        devicePixelRatio: win.devicePixelRatio,
+        viewportWidth: win.innerWidth,
+        viewportHeight: win.innerHeight,
+      },
+    });
+  }
