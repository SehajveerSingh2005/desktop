+  /**
+   * Capture a region and send the blob to the board picker.
+   * Dispatches a ZenBoard:CaptureReady event to the chrome window.
+   */
+  async zenSendCaptureToBoard(region, anchor, browser) {
+    try {
+      const canvas = await this.createCanvas(region, browser);
+      const blob = await canvas.convertToBlob({ type: "image/png" });
+      const sourceUrl = browser.currentURI?.spec ?? "";
+
+      const chromeWin = browser.ownerDocument.defaultView;
+      const event = new chromeWin.CustomEvent("ZenBoard:CaptureReady", {
+        bubbles: false,
+        cancelable: false,
+        detail: {
+          blob,
+          sourceUrl,
+          region: {
+            left: region.left || 0,
+            top: region.top || 0,
+            width: region.width,
+            height: region.height,
+            devicePixelRatio: region.devicePixelRatio || 1,
+            viewportWidth: region.viewportWidth || 0,
+            viewportHeight: region.viewportHeight || 0,
+          },
+          anchor,
+        },
+      });
+      chromeWin.dispatchEvent(event);
+    } catch (e) {
+      console.error("ZenBoard: Failed to capture screenshot for board: ", e);
+    }
+  },
+
